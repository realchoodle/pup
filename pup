#!/usr/bin/env bash

name="${0##*/}"
re=$'\E(B\E[m'
red=$'\E[31m'
grn=$'\E[32m'
ylw=$'\E[33m'
bl=$'\E[1m'
it=$'\E[3m'

bad="${ printf "%s" "${bl}${red}${name}:${re}"; }"
ok="${  printf "%s" "${bl}${grn}${name}:${re}"; }"

run_and_check() {
	local -a cmd
	cmd=("${@}")

	if ! command -v "${cmd[0]}" > /dev/null 2>&1
	then
		echo "$bad ${it}${cmd[0]}${re} is not installed!" >&2
		exit 1
	else
		echo "$ok Running ${it}${cmd[*]}${re}"

		local -i code
		"${cmd[@]}"
		code="$?"

		if (( code == 0 ))
		then
			pkill -SIGRTMIN+1 i3status-rs 2>/dev/null || true
		else
			echo "$bad ${it}${cmd[*]}${re} failed! (exit $code)" >&2
			exit "$code"
		fi
	fi
}

declare -a update_cmds
update_cmds=(
	"paru --sync --refresh --sysupgrade --newsonupgrade"
	"flatpak update --user --assumeyes"
	"tldr --update"
	"rustup update"
	"ollup"
	"fup"
)

for update_cmd in "${update_cmds[@]}"
do
	# shellcheck disable=SC2086
	run_and_check ${update_cmd}
	echo
done
