#!/usr/bin/env bash

declare bad ok

bad=${ printf "\033[0;31m%s\033[0m" "pup:"; }
ok=${ printf "\033[0;32m%s\033[0m" "pup:"; }

run_and_check() {
    local -i exit_status
    local -a cmd
    cmd=("$@")

    if ! command -v "${cmd[0]}" > /dev/null 2>&1
    then
        echo "$bad '${cmd[0]}' is not installed."
        exit 1
    else
        echo -e "\n${ok} Updating packages with: '${cmd[*]}'"

        "${cmd[@]}"
        exit_status="$?"
        pkill -SIGRTMIN+1 i3status-rs # for my status bar

        if (( exit_status != 0 ))
        then
            echo "$bad ${cmd[*]} failed with exit status ${exit_status}."
            exit 1
        fi
    fi
}

declare -a update_cmds
update_cmds=(
    paru --sync --refresh --sysupgrade
    flatpak update --user --assumeyes
    tldr --update
    rustup update
)

for cmd in "${update_cmds[@]}"
do
    run_and_check "$cmd"
done

echo "${ok} Done!"
if command -v notify-send > /dev/null 2>&1
then notify-send \
    --app-name="pup" \
    "pup" \
    "Updates complete."
fi
