#!/usr/bin/env bash

declare red green reset
red=${ tput setaf 9; }
green=${ tput setaf 10; }
reset=${ tput sgr0; }

declare bad ok
bad=${ printf "${red}%s${reset}" "pup:"; }
ok=${ printf "${green}%s${reset}" "pup:"; }

run_and_check() {
    local -a cmd
    cmd=("${@}")

    if ! command -v "${cmd[0]}" > /dev/null 2>&1
    then
        echo "${bad} '${cmd[0]}' is not installed!" >&2
        exit 1
    else
        echo "${ok} Running '${cmd[*]}'..."

        local -i exit_status
        "${cmd[@]}"
        exit_status="$?"

        if (( exit_status == 0 ))
        then
            pkill -SIGRTMIN+1 i3status-rs # for my status bar
        else
            echo "${bad} ${cmd[*]} failed with exit status ${exit_status}!" >&2
            exit 1
        fi
    fi
}

declare -a update_cmds
update_cmds=(
    "paru --sync --refresh --sysupgrade"
    "flatpak update --user --assumeyes"
    "tldr --update"
    "rustup update"
)

for update_cmd in "${update_cmds[@]}"
do
    # No quoting; run_and_check() takes advantage of splitting
    run_and_check ${update_cmd}
    echo
done

echo "${ok} Done."

if command -v notify-send > /dev/null 2>&1
then
    notify-send --app-name="pup" "pup" "Updates complete."
fi
