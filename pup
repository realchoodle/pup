#!/usr/bin/env bash

declare res red grn ylw
res="${ tput sgr0; }"
red="${ tput setaf 9; }"
grn="${ tput setaf 10; }"
ylw="${ tput setaf 11; }"

declare bad ok
bad="${ printf "${red}%s${res}" "pup:"; }"
ok="${ printf "${grn}%s${res}" "pup:"; }"

run_and_check() {
    local -a cmd
    cmd=("${@}")

    if ! command -v "${cmd[0]}" > /dev/null 2>&1
    then
        echo "${bad} ${ylw}'${cmd[0]}'${res} is not installed!" >&2
        exit 1
    else
        echo "${ok} Running ${ylw}'${cmd[*]}'${res}..."

        local -i status
        "${cmd[@]}"
        status="$?"

        if (( status == 0 ))
        then
            pkill -SIGRTMIN+1 i3status-rs # for my status bar
        else
            echo "${bad} ${ylw}'${cmd[*]}'${res} failed! (exit ${status})" >&2
            exit 1
        fi
    fi
}

declare -a update_cmds
update_cmds=(
    "paru --sync --refresh --sysupgrade"
    "flatpak update --user --assumeyes"
    "tldr --update"
    "rustup update"
)

for update_cmd in "${update_cmds[@]}"
do
    # No quoting; run_and_check() takes advantage of splitting
    run_and_check ${update_cmd}
    echo
done

echo "${ok} Done."

if command -v notify-send > /dev/null 2>&1
then
    notify-send --app-name="pup" "pup" "Updates complete."
fi
